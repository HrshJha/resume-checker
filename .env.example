# ============================================================
# Candidate Intelligence System — Environment Configuration
# ============================================================

# --- Model Paths ---
MODEL_PATH=./models
FAISS_INDEX_PATH=./models/embeddings/faiss_index.faiss
RANKER_MODEL_PATH=./models/ranker/xgboost_ranker_v1.json
AUTHENTICITY_MODEL_PATH=./models/authenticity/evidence_model_v1.pkl

# --- Embedding Models (downloaded at build time) ---
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Database ---
DB_URL=sqlite+aiosqlite:///./data/candidate_ai.db
# DB_URL=postgresql+asyncpg://user:password@db:5432/candidate_ai

# --- Cache ---
REDIS_URL=redis://localhost:6379/0

# --- Security ---
SECRET_KEY=change-me-to-a-random-32-character-minimum-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- API ---
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=10
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# --- Retrieval ---
TOP_K_RETRIEVAL=500
TOP_K_RERANK=100

# --- Features ---
FEATURE_CONFIG_PATH=./configs/feature_config.json
FEATURE_VERSION=v1

# --- Upload ---
UPLOAD_DIR=./data/uploads
